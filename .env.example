# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# Max accepted upload size in megabytes.
MAX_UPLOAD_MB=15

# --- standalone_api.py only (the pure-stdlib, no-Django server) ---
STANDALONE_HOST=127.0.0.1
STANDALONE_PORT=8020

# No Anthropic/AI config needed anymore — extraction is fully local and
# offline (see local_invoice_extractor.py). No API key required.
